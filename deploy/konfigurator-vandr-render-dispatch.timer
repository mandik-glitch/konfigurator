[Unit]
Description=Casovac automatu render fronty pro Vandr karty (kazdych 5 minut)
# Robert 2026-09-24: "15 minut je moc, zkrat to na 5 min" (rychlejsi
# reakce po tom, co bot10 zapise nova razitka). Uz nema smysl stagger
# vuci razitkam (:14/15) drzet presne - test "otisk sedi" funguje
# spravne bez ohledu na poradi behu (viz 2026-09-23_vandr_render_auto_
# dispatch.py), takze staci bezet na vlastnim 5minutovem cyklu.
# Samotna davka trva ~20-30 min na JEDINE GPU stanici (X30-02, sdilena
# s nativni vetvi) - dalsi beh timeru behem toho jen najde "0 kandidatu
# bez aktivniho jobu" a nic nezarad, viz _aktivni_joby_podle_shop_product.
[Timer]
OnCalendar=*-*-* *:0/5:00
Persistent=true
RandomizedDelaySec=15

[Install]
WantedBy=timers.target
