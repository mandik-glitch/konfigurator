[Unit]
Description=Konfigurator - automat, ktery sam aktivuje kartu, jakmile ma dokonceny render
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/konfigurator
EnvironmentFile=/opt/konfigurator/api/.env
ExecStart=/opt/konfigurator/api/venv/bin/python3 /opt/konfigurator/scripts/2026-09-16_card_auto_activate.py
