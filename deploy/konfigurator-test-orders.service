[Unit]
Description=Konfigurator - denni testovaci objednavky (2/den, WORKFLOW.md bod 27)
After=network.target
# POJISTKA PROTI SOUBEHU NA SPOUSTECI VRSTVE (WORKFLOW.md bod 28).
# Nespolehat jen na kontrolu uvnitr skriptu - presne tahle chyba nadelala
# 20+ oken renderovaciho agenta: pojistka chranila proces, ale spousteci
# vrstva o ni nevedela. Uklid a generator si nesmi lezt do cesty (oboji
# saha na tytez radky), proto Conflicts obema smery.
Conflicts=konfigurator-test-orders-cleanup.service

[Service]
Type=oneshot
User=root
Group=root
Nice=15
# Druhy soubezny start teze unity systemd odmitne sam (oneshot + tahle
# volba) - unit se nespusti podruhe, dokud prvni bezi.
TimeoutStartSec=15min
WorkingDirectory=/opt/konfigurator
ExecStart=/opt/konfigurator/api/venv/bin/python3 /opt/konfigurator/scripts/2026-09-10_denni_testovaci_objednavky.py
# Zadny Restart= - bod 28 "tvrdy strop": kdyz to selze, ma to skoncit a
# byt videt v `systemctl --failed`, ne se opakovat do nekonecna.
