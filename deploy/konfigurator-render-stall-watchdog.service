[Unit]
Description=Konfigurator - hlidac zaseknuti renderovaci fronty (jen detekce a hlaseni, nic nerestartuje/nezabiji)
After=network.target mysql.service

[Service]
Type=oneshot
# User=root - stejny duvod jako konfigurator-vandr-render-dispatch: potrebuje
# zapisovat do AGENTS_LOG.md (root:root, www-data nema pravo zapisu - overeno
# 2026-09-25 pred nasazenim). Cte jen (kandidati/.status.json/.worker_heartbeat.json),
# nic nerenderuje, nepotrebuje render klic.
User=root
Group=root
WorkingDirectory=/opt/konfigurator
EnvironmentFile=/opt/konfigurator/api/.env
ExecStart=/opt/konfigurator/api/venv/bin/python3 /opt/konfigurator/scripts/2026-09-25_render_stall_watchdog.py
