[Unit]
Description=Konfigurator - Vandr (vanDrawee) FBX watcher: detekuje nove FBX na Sdilenem disku, zaklada/paruje karty
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/konfigurator
EnvironmentFile=/opt/konfigurator/api/.env
ExecStart=/opt/konfigurator/api/venv/bin/python3 /opt/konfigurator/scripts/2026-09-22_vandr_fbx_watcher.py --apply
