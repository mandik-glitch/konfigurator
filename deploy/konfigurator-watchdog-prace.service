[Unit]
Description=Konfigurator - automat, ktery si sam bere praci z prehledu vyroby sestav (kusovnik/cena)
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/konfigurator
EnvironmentFile=/opt/konfigurator/api/.env
ExecStart=/opt/konfigurator/api/venv/bin/python3 /opt/konfigurator/scripts/2026-09-11_watchdog_prace.py
