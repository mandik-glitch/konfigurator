[Unit]
Description=Casovac automatu FBX->GLB konverze pro Vandr karty (kazdych 15 minut)
# Poradi v ramci 15minutove periody (Robert primo, 2026-09-23 - "udelej
# ten automat"): fbx-watcher :10 (zalozi/sparuje kartu) -> KONVERZE :11
# (tenhle timer, prevede FBX na GLB) -> card-activate :12 (aktivuje,
# pokud je vse pripravene) -> razitka :14 (orazitkuje kartu s cerstvym
# GLB). Kazdy krok je nezavisly (nic neceka tvrde na predchozi), ale
# tenhle stagger da nove karte sanci projit celym retezcem v JEDNE
# 15minutove periode misto cekani na dalsi kolo.
[Timer]
OnCalendar=*-*-* *:11/15:00
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
